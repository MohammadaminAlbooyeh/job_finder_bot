# Used by `docker compose build` for the frontend image.
# Must be an address the BROWSER viewing the page can reach — not "localhost"
# unless you always view the page on the same machine that runs Docker.
# Example for a mini PC on your LAN at 192.168.1.50, backend on host port 8001:
# VITE_API_URL=http://192.168.1.50:8001
VITE_API_URL=http://localhost:8001
